<Window
    x:Class="Applaio.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Applaio">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent" RowDefinitions="44,*">
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent"
            Height="44"
            ColumnDefinitions="Auto,*">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                Spacing="10">
                <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                <TextBlock
                    Text="Applaio"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="RootNavigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Rekrutacje" Tag="recruitments">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Firmy" Tag="companies">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Import" Tag="import">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Upload"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="28" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="PageTitle"
                            Text="Dashboard"
                            Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock
                            x:Name="PageSubtitle"
                            Text="Śledź cały proces rekrutacji w jednym miejscu."
                            Opacity="0.68"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid x:Name="DashboardView" RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                            <Border
                                Padding="18"
                                CornerRadius="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Wszystkie" Opacity="0.65"/>
                                    <TextBlock x:Name="DashboardCountText" Text="0" FontSize="30" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="18"
                                CornerRadius="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Aktywne" Opacity="0.65"/>
                                    <TextBlock x:Name="DashboardActiveText" Text="0" FontSize="30" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="18"
                                CornerRadius="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Rozmowy" Opacity="0.65"/>
                                    <TextBlock x:Name="DashboardInterviewText" Text="0" FontSize="30" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="3"
                                Padding="18"
                                CornerRadius="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Oferty" Opacity="0.65"/>
                                    <TextBlock x:Name="DashboardOfferText" Text="0" FontSize="30" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            CornerRadius="18"
                            Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Co dalej?" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock
                                    TextWrapping="Wrap"
                                    Opacity="0.75"
                                    Text="Dodawaj rekrutacje ręcznie, aktualizuj etapy procesu i terminy kolejnych działań. Import Excela służy tylko do migracji danych startowych."/>
                                <Button
                                    Click="NewRecruitmentButton_Click"
                                    HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add"/>
                                        <TextBlock Text="Nowa rekrutacja"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="RecruitmentsView" Visibility="Collapsed" RowDefinitions="Auto,Auto,*">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <TextBox
                                x:Name="RecruitmentSearchBox"
                                PlaceholderText="Szukaj po firmie, stanowisku, statusie lub stacku..."
                                TextChanged="RecruitmentSearchBox_TextChanged"
                                MaxWidth="560"
                                HorizontalAlignment="Stretch"/>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="RecruitmentCountText"
                                VerticalAlignment="Center"
                                Opacity="0.7"/>
                            <Button
                                Grid.Column="2"
                                Click="NewRecruitmentButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Add"/>
                                    <TextBlock Text="Nowa rekrutacja"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <InfoBar
                            Grid.Row="1"
                            x:Name="RecruitmentResultBar"
                            Margin="0,12,0,0"
                            IsOpen="False"
                            IsClosable="True"/>

                        <ListView
                            x:Name="RecruitmentsList"
                            Grid.Row="2"
                            Margin="0,14,0,0"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="16"
                                        CornerRadius="14"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Grid ColumnDefinitions="2.1*,1.2*,1.5*,1.35*,Auto,Auto" ColumnSpacing="16">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Company}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Position}" Opacity="0.72" TextWrapping="Wrap"/>
                                                <TextBlock
                                                    Text="{Binding PrimaryStack}"
                                                    Margin="0,5,0,0"
                                                    FontSize="12"
                                                    Opacity="0.55"
                                                    TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Etap procesu" FontSize="11" Opacity="0.55"/>
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding PriorityAndFit}" Margin="0,5,0,0" FontSize="12" Opacity="0.65"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Następny krok" FontSize="11" Opacity="0.55"/>
                                                <TextBlock Text="{Binding NextAction}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding NextActionDue}" Margin="0,5,0,0" FontSize="12" Opacity="0.65"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Warunki" FontSize="11" Opacity="0.55"/>
                                                <TextBlock Text="{Binding WorkAndRate}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Source}" Margin="0,5,0,0" FontSize="12" Opacity="0.65"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StartedOn}" FontSize="12" Opacity="0.65"/>
                                                <TextBlock Text="{Binding DaysInProcess}" FontSize="12" Opacity="0.55" HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="5"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                                <Button
                                                    Tag="{Binding Id}"
                                                    Click="EditRecruitmentButton_Click"
                                                    ToolTipService.ToolTip="Edytuj">
                                                    <SymbolIcon Symbol="Edit"/>
                                                </Button>
                                                <Button
                                                    Tag="{Binding Id}"
                                                    Click="DeleteRecruitmentButton_Click"
                                                    ToolTipService.ToolTip="Usuń">
                                                    <SymbolIcon Symbol="Delete"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="CompaniesView" Visibility="Collapsed">
                        <Border
                            CornerRadius="18"
                            Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <TextBlock Text="Widok firm do zbudowania w kolejnym kroku."/>
                        </Border>
                    </Grid>

                    <Grid x:Name="ImportView" Visibility="Collapsed">
                        <Border
                            CornerRadius="18"
                            Padding="26"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="Migracja danych z Excela" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock
                                    TextWrapping="Wrap"
                                    Opacity="0.75"
                                    Text="Import służy do migracji istniejących danych do lokalnej bazy. Po imporcie dalszą pracę wykonujesz bezpośrednio w module Rekrutacje."/>
                                <Button
                                    x:Name="ImportWorkbookButton"
                                    Click="ImportWorkbookButton_Click"
                                    HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Upload"/>
                                        <TextBlock Text="Wybierz Excel i zaimportuj"/>
                                    </StackPanel>
                                </Button>
                                <ProgressRing
                                    x:Name="ImportProgressRing"
                                    IsActive="False"
                                    Visibility="Collapsed"
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Left"/>
                                <InfoBar
                                    x:Name="ImportResultBar"
                                    IsOpen="False"
                                    IsClosable="True"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="SettingsView" Visibility="Collapsed">
                        <Border
                            CornerRadius="18"
                            Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <TextBlock Text="Ustawienia Applaio pojawią się tutaj."/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
