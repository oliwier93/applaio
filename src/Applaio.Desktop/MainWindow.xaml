<Window
    x:Class="Applaio.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Applaio">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="RootNavigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Rekrutacje" Tag="recruitments">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Firmy" Tag="companies">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Import" Tag="import">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Upload"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="32" RowDefinitions="Auto,*">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="PageTitle"
                        Text="Dashboard"
                        Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock
                        x:Name="PageSubtitle"
                        Text="Śledź cały proces rekrutacji w jednym miejscu."
                        Opacity="0.7"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,0">
                    <Border
                        CornerRadius="18"
                        Padding="24"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="18">
                            <TextBlock
                                Text="Applaio"
                                FontSize="32"
                                FontWeight="SemiBold"/>
                            <TextBlock
                                MaxWidth="680"
                                TextWrapping="Wrap"
                                Text="Nowoczesny, lokalny tracker rekrutacji dla Windows 11. Kolejny krok: migracja Twoich rzeczywistych danych z Excela i zbudowanie widoku pipeline."
                                FontSize="16"/>
                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Informational"
                                Title="Pierwsza migracja"
                                Message="Importer jest wydzielony architektonicznie. Po dostarczeniu Excela odwzorujemy jego kolumny bez uzależniania domeny od formatu arkusza."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
